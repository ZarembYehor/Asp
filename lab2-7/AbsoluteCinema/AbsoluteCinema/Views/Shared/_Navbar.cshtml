@model IEnumerable<string>

<div class="list-group">
    <a asp-controller="Home" asp-action="Index"
       class="list-group-item list-group-item-action @(ViewBag.SelectedGenre == null ? "active" : "")">
        All Films
    </a>

    @foreach (var genre in Model)
    {
        <a asp-controller="Home"
           asp-action="Index"
           asp-route-genre="@genre"
           class="list-group-item list-group-item-action @(ViewBag.SelectedGenre == genre ? "active" : "")">
            @genre
        </a>
    }
</div>
