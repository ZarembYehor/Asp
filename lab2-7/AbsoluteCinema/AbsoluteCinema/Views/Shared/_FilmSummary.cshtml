@model AbsoluteCinema.Models.Film

<div class="col">
    <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
        @if (!string.IsNullOrEmpty(Model.PosterUrl))
        {
            <div class="card-img-wrapper" style="height: 350px; overflow: hidden;">
                <img src="@Model.PosterUrl" class="card-img-top object-fit-cover w-100 h-100" alt="@Model.Title" />
            </div>
        }
        <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title fw-bolder text-dark mb-0 flex-grow-1">
                    @Model.Title
                    <span class="text-muted fw-normal fs-6">(@Model.ReleaseYear)</span>
                </h5>
                <span class="badge rounded-pill bg-success-subtle text-success ms-3 p-2 fw-bold">
                    @Model.TicketPrice.ToString("c")
                </span>
            </div>

            <p class="card-text text-secondary small flex-grow-1 mb-3">
                @((Model.Description.Length > 150 ? Model.Description.Substring(0, 150) + "..." : Model.Description) ?? "No description available.")
            </p>

            <div class="mt-auto pt-3 border-top">
                <div class="mb-3">
                    <span class="badge bg-info text-dark fw-medium px-3 py-2 me-2">
                        <i class="bi bi-tag-fill me-1"></i> @Model.Genre
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary fw-medium px-3 py-2">
                        <i class="bi bi-clock-fill me-1"></i> @Model.DurationMinutes min
                    </span>
                </div>

                <a asp-controller="Booking" asp-action="SelectSeats" class="btn btn-primary w-100 rounded-pill mt-2 fw-medium shadow-sm">
                    <i class="bi bi-ticket-fill me-1"></i> Book Now
                </a>
            </div>
        </div>
    </div>
</div>
<style>
    .transform-on-hover {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

        .transform-on-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }
</style>