@model IEnumerable<string>

<div class="list-group list-group-flush border rounded-3 shadow-sm mb-4">
    <a asp-controller="Home"
       asp-action="Index"
       asp-route-genre=""
       class="list-group-item list-group-item-action @(ViewBag.SelectedGenre == null ? "active list-group-item-primary" : "") fw-bold">
        <i class="bi bi-collection-fill me-2"></i> All Films
    </a>

    @foreach (var genre in Model)
    {
        <a asp-controller="Home"
           asp-action="Index"
           asp-route-genre="@genre"
           class="list-group-item list-group-item-action @(genre == (string)ViewBag.SelectedGenre ? "active list-group-item-primary fw-medium" : "")">
            <i class="bi bi-caret-right-fill me-2"></i> @genre
        </a>
    }
</div>