@model AbsoluteCinema.Models.ViewModels.ProfileModel

@{
    ViewData["Title"] = "User Profile";
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Особистий кабінет</h2>

            @if (TempData["message"] != null)
            {
                <div class="alert alert-success">@TempData["message"]</div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    Зміна пароля
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>

                    <form asp-action="Profile" method="post">

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>

                        <h5 class="mt-4 mb-3">Змінити пароль (залиште порожнім, якщо не потрібно)</h5>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4 mb-3">Підтвердження</h5>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label"></label>
                            <input asp-for="CurrentPassword" class="form-control" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                            <small class="text-muted">Для збереження змін завжди потрібен поточний пароль.</small>
                        </div>

                        <div class="d-grid mt-4">
                            <button class="btn btn-warning btn-lg" type="submit">Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>