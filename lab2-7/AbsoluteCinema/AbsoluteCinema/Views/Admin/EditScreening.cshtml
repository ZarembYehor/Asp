@model AbsoluteCinema.Models.Screening

@{
    ViewData["Title"] = Model.ScreeningID == 0 ? "Create Screening" : "Edit Screening";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>

    <form asp-action="EditScreening" method="post">
        <input type="hidden" asp-for="ScreeningID" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="FilmID" class="form-label">Film</label>
            <select asp-for="FilmID" asp-items="@ViewBag.Films" class="form-select">
                <option value="">-- Select Film --</option>
            </select>
            <span asp-validation-for="FilmID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StartTime" class="form-label">Start Time</label>
            <input asp-for="StartTime" class="form-control" type="datetime-local"
                   value="@(Model.StartTime.HasValue? Model.StartTime.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty)" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CinemaHall" class="form-label">Cinema Hall</label>
            <input asp-for="CinemaHall" class="form-control" type="number" />
            <span asp-validation-for="CinemaHall" class="text-danger"></span>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Screenings" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}